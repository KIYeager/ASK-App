{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASK-Tauri-Spike",
  "version": "0.0.1",
  "identifier": "ch.tfbern.ask.spike",
  "build": {
    "frontendDist": "../../../src/renderer/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}