{
  "name": "ask-desktop",
  "productName": "ASK",
  "version": "0.1.0",
  "description": "ASK Desktop: Open WebUI der TF Bern mit lokalem Arbeitsordner",
  "main": "src/main/main.js",
  "private": true,
  "author": "TF Bern",
  "license": "UNLICENSED",
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "build:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-python.ps1",
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "test:e2e": "node tests/e2e/run.js chat && node tests/e2e/run.js anmelden && node tests/e2e/run.js erststart && node tests/e2e/run.js coworker",
    "dist": "electron-builder --config electron-builder.config.js --win",
    "dist:portable": "node scripts/build-portable.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "globals": "17.14.0"
  }
}
