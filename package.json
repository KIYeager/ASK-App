{
  "name": "ask-desktop",
  "productName": "ASK",
  "version": "0.4.2-beta.9",
  "description": "ASK Desktop: Open WebUI der TF Bern mit lokalem Arbeitsordner (Tauri)",
  "private": true,
  "author": "TF Bern",
  "license": "UNLICENSED",
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "build:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-python.ps1",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "start": "tauri dev",
    "tauri": "tauri",
    "test": "node --test tests/*.test.js",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "lint": "eslint .",
    "dist": "node scripts/dist.js",
    "dist:portable": "node scripts/build-portable.js",
    "release": "node scripts/release.js",
    "test:e2e": "node tests/e2e/packaged-test.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tauri-apps/cli": "2.12.6",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.8"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5"
  }
}
